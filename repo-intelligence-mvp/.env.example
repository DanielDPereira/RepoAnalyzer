OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
MAX_REPO_SIZE_MB=300
MAX_FILE_SIZE_KB=500
MAX_CHUNK_CHARS=10000
MAX_FILES=1000
WORKSPACE_DIR=workspace
REQUEST_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=5m

# Desliga o modo "thinking" do Qwen3 (e outros modelos com raciocínio),
# evitando que blocos <think>...</think> apareçam no relatório final.
OLLAMA_THINK=false

# Tentativas extras em caso de falha transitória de rede/timeout com o Ollama.
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=3

# Orçamento (em caracteres) de resumos enviados de uma vez ao modelo nas
# etapas de consolidação, para não estourar a janela de contexto de modelos
# pequenos como o Qwen3 4B em repositórios grandes.
MAX_SYNTHESIS_CHARS=60000

# Arquivos analisados em paralelo. 1 = sequencial (padrão, seguro para
# instalações locais comuns). Só aumente se o seu servidor Ollama realmente
# atende requisições em paralelo.
OLLAMA_CONCURRENCY=1
